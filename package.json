{
  "name": "stripe-mcp",
  "version": "1.0.0",
  "description": "Stripe MCP Server - HTTP transport",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:web": "node dist/web-server.js",
    "start:both": "concurrently \"npm run start\" \"npm run start:web\"",
    "dev": "ts-node src/index.ts",
    "dev:web": "ts-node src/web-server.ts",
    "dev:both": "concurrently \"npm run dev\" \"npm run dev:web\"",
    "test": "tsc && node --test dist/**/*.test.js && npm test --prefix stripe-connect-sample"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "stripe": "^15.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
