# Stripe API Key (get from https://dashboard.stripe.com/apikeys)
# For platform accounts, use a restricted API key with appropriate scopes
STRIPE_API_KEY=sk_test_your_api_key_here

# Stripe Publishable Key (for frontend checkout)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# MCP Server Authentication Token (optional - if not set, auth is disabled)
# Generate a secure token and provide it to clients via Bearer token auth
MCP_API_KEY=your_secure_api_key_here

# MCP Server Port (default: 8000)
PORT=8000

# Website Server Port (default: 3000)
WEB_PORT=3000

# Domain for checkout success/cancel redirects
DOMAIN=http://localhost:3000

# Optional: Log level
LOG_LEVEL=info

# Note: Connected account ID can be specified per-request via Stripe-Account header
# Example: Stripe-Account: acct_xxxxxxxxx
