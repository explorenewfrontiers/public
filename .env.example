# Stripe API Key (get from https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=sk_test_your_api_key_here

# MCP Server Authentication Token (optional - if not set, auth is disabled)
# Generate a secure token and provide it to clients via Bearer token auth
MCP_API_KEY=your_secure_api_key_here

# Server Port (default: 8000)
PORT=8000

# Optional: Log level
LOG_LEVEL=info
