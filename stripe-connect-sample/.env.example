# ============================================================================
# STRIPE API KEYS
# ============================================================================
# Get these from https://dashboard.stripe.com/apikeys
#
# STRIPE_SECRET_KEY: Your secret API key - used for server-side operations
#                   Must keep this private - never expose to client
#                   Format: sk_test_... or sk_live_...
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# STRIPE_PUBLISHABLE_KEY: Your publishable key - safe to expose to client
#                         Used for Stripe.js on the frontend
#                         Format: pk_test_... or pk_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# ============================================================================
# WEBHOOK SECRET
# ============================================================================
# Found in Stripe Dashboard > Developers > Webhooks > Select endpoint
# This is used to verify that webhook events actually come from Stripe
# Format: whsec_... (starts with whsec_)
WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# PORT: Which port to run the server on
#       Default: 3000
PORT=3000

# DOMAIN: Base URL for your application
#         Used for redirect URLs in Stripe Checkout and Account Links
#         Examples:
#         - Development: http://localhost:3000
#         - Production: https://yourdomain.com
DOMAIN=http://localhost:3000

# ============================================================================
# NOTES ON GETTING YOUR KEYS
# ============================================================================
#
# 1. Create a Stripe account at https://dashboard.stripe.com
#
# 2. Go to Developers > API Keys to find your keys
#    - You'll see both Test and Live keys
#    - Start with Test keys (they begin with sk_test_ and pk_test_)
#
# 3. For Webhook Secret:
#    - Go to Developers > Webhooks
#    - Click "Add endpoint"
#    - Enter your webhook URL: https://yourdomain.com/webhook
#    - Select events to listen to
#    - Copy the signing secret (whsec_...)
#
# 4. Set up thin webhooks for V2 accounts:
#    - Create another endpoint for thin events
#    - Select "Connected accounts" in "Events from"
#    - Select "Show advanced options"
#    - Choose "Thin" in "Payload style"
#    - Select V2 events to listen to
#    - URL: https://yourdomain.com/webhook/thin
